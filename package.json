{
  "name": "tcg-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "sync:catalog": "tsx --env-file=.env.local scripts/sync-catalog.ts",
    "sync:prices": "tsx --env-file=.env.local scripts/sync-prices.ts",
    "auth:generate": "node --env-file=.env.local node_modules/auth/dist/index.mjs generate --adapter drizzle --dialect pg --output src/db/auth-schema.ts -y"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@neondatabase/serverless": "^1.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.7",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}
